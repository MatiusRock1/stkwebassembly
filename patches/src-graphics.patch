 #include <IVideoDriver.h>
 #include <cmath>
 
+// ----------------------------------------------------------------------------
+/** Clears the GL error flag after a 2D draw. In WebGL getError waits for the
+ *  GPU process: called after every HUD image it took a quarter of each frame
+ *  on desktop and made phones lag, and the result is discarded anyway. */
+static void clearGLError()
+{
+#ifndef __EMSCRIPTEN__
+    glGetError();
+#endif
+}   // clearGLError
+
