     glBindVertexArray(0);
     glBindBuffer(GL_ARRAY_BUFFER, 0);
 
-    glGetError();
+    clearGLError();
 }   // drawTexQuad
 
 
@@ -292,7 +303,7 @@ void draw2DImage(const video::ITexture* texture,
         glDisable(GL_SCISSOR_TEST);
     glUseProgram(0);
 
-    glGetError();
+    clearGLError();
 }   // draw2DImage
 
 // ----------------------------------------------------------------------------
@@ -392,7 +403,7 @@ void draw2DImage(const video::ITexture* texture,
